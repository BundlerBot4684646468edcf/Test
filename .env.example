# Database
DATABASE_URL=postgresql://stempl:stempl_password@localhost:5432/stempl_db

# Server
PORT=3000
NODE_ENV=development

# Apple Wallet (PassKit)
# Path to your .p12 certificate (export from Apple Developer Portal)
APPLE_PASS_TYPE_ID=pass.com.stempl.loyalty
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_CERT_PATH=./certs/PassTypeID.p12
APPLE_CERT_PASSWORD=YOUR_CERT_PASSWORD
APPLE_WWDR_CERT_PATH=./certs/AppleWWDRCA.pem

# Apple Push Notification Service (APNs)
APPLE_APNS_KEY_ID=YOUR_KEY_ID
APPLE_APNS_TEAM_ID=YOUR_TEAM_ID
APPLE_APNS_AUTH_KEY_PATH=./certs/AuthKey_XXXXXXXX.p8

# Google Wallet API
GOOGLE_WALLET_SERVICE_ACCOUNT_PATH=./certs/google-service-account.json
GOOGLE_WALLET_ISSUER_ID=3388000000022804865

# Application URLs
APP_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# SMTP (for future email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
