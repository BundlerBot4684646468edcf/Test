# DATABASE
# SQLite — a single local file, created automatically. No server, no Docker.
# Leave empty to use ./mundpost.db, or set a custom path.
DB_FILE=

# GOOGLE PLACES API
# Get from: https://console.cloud.google.com/
# See SETUP.md for full instructions
GOOGLE_PLACES_API_KEY=

# TWILIO SMS SERVICE
# Get from: https://console.twilio.com/
# Account SID, Auth Token, and Phone Number
# See SETUP.md for full instructions
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# RESEND EMAIL SERVICE
# Get from: https://resend.com/api-keys
# See SETUP.md for full instructions
RESEND_API_KEY=

# CLOUDFLARE R2 (optional - for photo uploads)
# Get from: https://dash.cloudflare.com/
# Not required for development (uses mock storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# SERVER CONFIG
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Public https URL this server is reachable at — used to build links to
# locally-stored photos (e.g. inline in emails). In production, set this to
# your real domain, e.g. https://api.mundpost.example
PUBLIC_BASE_URL=http://localhost:3000

# Where uploaded photos are stored on disk. Leave empty to use ./uploads.
# In production (e.g. Railway), point this at a mounted persistent volume,
# e.g. /data/uploads, so photos survive redeploys.
UPLOADS_DIR=

# CLOUDFLARE R2 — public base URL of your bucket (needed for photo-MMS)
# e.g. https://pub-xxxxxxxx.r2.dev  (enable "Public access" on the bucket)
R2_PUBLIC_BASE_URL=
