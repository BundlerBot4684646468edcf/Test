// Prisma schema for Hotel Decision Simulator

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  scenarios    Scenario[]

  @@map("users")
}

model Scenario {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?

  // Simulation inputs
  requestsPerDay    Int
  numReceptionists  Int
  salary            Int
  aiCost            Int
  aiCanHandle       Float // 0-1
  humanUpsellRate   Float // 0-1
  aiUpsellRate      Float // 0-1
  avgUpsellValue    Int

  // Simulation outputs (stored for quick access)
  humanCapacity       Int
  aiCapacity          Int
  totalCapacity       Int
  loadFactor          Float
  aiHandled           Float
  humanHandled        Float
  unhandled           Float
  satisfaction        Float
  upsellRevenueMonth  Float
  staffCost           Int
  totalCost           Int
  netGain             Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("scenarios")
  @@index([userId])
}
